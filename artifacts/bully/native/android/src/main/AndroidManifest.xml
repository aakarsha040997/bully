<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Declares the Usage Access special permission so:
        1. Bully appears in Settings → Apps → Special App Access → Usage Access
        2. UsageStatsManager.queryAndAggregateUsageStats() returns real data
      Without this declaration the system blocks usage stat queries entirely,
      even after the user enables the toggle manually.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Android 11+ (API 30) restricts PackageManager.getApplicationInfo() to
      packages explicitly visible to the app. This allows resolving human-readable
      app names for any package returned by UsageStatsManager.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

</manifest>
